# Application Settings
DEBUG=False
SECRET_KEY=your-secret-key-here
HOST=0.0.0.0
PORT=5000

# API Settings
RAG_API_URL=http://localhost:8000

# Database Settings (optional)
DATABASE_URL=postgresql://user:password@localhost/dockeragent
REDIS_URL=redis://localhost:6379

# Tracing and Monitoring
LANGTRACE_API_KEY=your-langtrace-api-key
GRAFANA_CLOUD_URL=https://your-instance.grafana.net
GRAFANA_CLOUD_API_KEY=your-grafana-api-key
PROMETHEUS_PORT=8001

# LLM Provider API Keys
OPENAI_API_KEY=YOUR_API_KEY
GROQ_API_KEY=YOUR_API_KEY
GOOGLE_API_KEY=YOUR_API_KEY

# Optional: Custom configurations
FRAMEWORKS=langgraph,autogen,llamaindex,dspy
MODELS=gpt-4o,gpt-4o-mini,gpt-3.5-turbo,llama3-8b-8192
VECTORSTORES=Faiss,Chroma,Annoy